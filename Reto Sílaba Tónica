<style>
:root{--red:#b6101e;--ink:#33252b;--gold:#e9b62b;--paper:#fffaf3}*{box-sizing:border-box}body{margin:0;background:var(--paper);color:var(--ink);font-family:system-ui,-apple-system,Segoe UI,sans-serif}header{background:white;border-bottom:5px solid var(--red);padding:16px 24px;display:flex;align-items:center;gap:15px}header img{width:72px;height:72px;object-fit:contain}header strong{display:block;font-size:18px}header span{font-size:14px;color:#655660}main{max-width:1000px;margin:auto;padding:24px}h1{font-size:clamp(32px,5vw,52px);line-height:1.12;margin:10px 0 15px}h2{margin:0 0 14px}p{line-height:1.6}button,input,select{font:inherit}button{cursor:pointer;border:0;border-radius:14px;padding:14px 22px;font-weight:750;background:var(--red);color:white;min-height:48px}button:hover{filter:brightness(.94)}button:disabled{cursor:default;opacity:.65}button:focus-visible,input:focus-visible,select:focus-visible,summary:focus-visible{outline:4px solid #176ead;outline-offset:4px}.secondary{background:white;color:var(--red);border:2px solid var(--red)}.eyebrow{color:var(--red);font-weight:800;letter-spacing:2px;font-size:13px;text-transform:uppercase}.panel{background:white;border:1px solid #ebdcd8;border-radius:24px;padding:26px;box-shadow:0 8px 25px #68232c08;margin:18px 0}.grid{display:grid;grid-template-columns:repeat(4,1fr);gap:12px}.concept{padding:18px;border-radius:17px;background:#faf1ef;border-top:4px solid var(--red)}.concept b{display:block}.concept .number{font-size:28px;color:var(--red);font-weight:850}.concept small{display:block;margin-top:8px;color:#66515a}.setup{display:flex;flex-wrap:wrap;gap:18px;align-items:end}label{display:block;font-weight:700;font-size:14px}input,select{display:block;margin-top:7px;padding:12px;border:1px solid #cab7b9;border-radius:10px;background:white;max-width:100%;width:230px}.row{display:flex;justify-content:space-between;align-items:center;gap:15px;flex-wrap:wrap}.tag{border-radius:99px;background:#faeed0;padding:8px 14px;font-weight:750}.stats{display:flex;gap:12px;flex-wrap:wrap}.stats span{padding:9px 14px;background:white;border:1px solid #e7d7d2;border-radius:12px}progress{width:100%;height:14px;accent-color:var(--red);margin:18px 0}.wordbox{text-align:center;padding:22px 10px}.word{font-size:clamp(42px,7vw,70px);font-weight:850;margin:12px 0 20px;overflow-wrap:anywhere}.choices button{background:#fff;color:var(--ink);border:2px solid #eadbd5;padding:20px 8px}.choices button strong{display:block;font-size:20px;color:var(--red)}.choices button span{font-size:14px;display:block;margin-top:5px}.choices .correct{border-color:#287247;background:#e9f7ee}.choices .wrong{border-color:var(--red);background:#fff0ef}.feedback{margin-top:20px;min-height:85px;padding:18px;background:#f8f4ec;border-radius:14px}.feedback.good{background:#e9f7ee;color:#205a39}.feedback.miss{background:#fff0ef;color:#8b1520}.actions{display:flex;gap:12px;flex-wrap:wrap;margin-top:18px}.score{font-size:64px;font-weight:850;color:var(--red);line-height:1.1}.hint{color:#715e65;font-size:14px}details{margin:18px 0}summary{cursor:pointer;font-weight:750}table{width:100%;border-collapse:collapse;text-align:left;font-size:15px}th,td{padding:12px 9px;border-bottom:1px solid #eadbd5}th{background:#faf1ef}.scroll{overflow:auto}footer{text-align:center;font-size:13px;color:#756168;padding:18px}.hidden,[hidden]{display:none!important}@media(max-width:650px){.grid{grid-template-columns:repeat(2,1fr)}main{padding:16px}.panel{padding:19px}header{padding:12px}.setup>div{width:100%}input,select{width:100%}.choices button strong{font-size:17px}}@media print{header{border-bottom:2px solid black}body{background:white}button,details,.actions,#home,#game{display:none!important}.panel{box-shadow:none;border:0}main{padding:0}#result{display:block!important}}

.hero-art{width:100%;max-height:300px;object-fit:cover;border-radius:24px;display:block;margin:18px 0}.visual-path{display:flex;gap:12px;align-items:center;justify-content:center;flex-wrap:wrap;padding:16px;background:#fff;border:2px dashed #d5bdaa;border-radius:18px;font-weight:750}.visual-path span{display:inline-flex;gap:8px;align-items:center}.claps{font-size:22px;display:block;margin-top:12px;letter-spacing:3px}.syllable-tiles{display:flex;gap:10px;justify-content:center;flex-wrap:wrap;margin:12px 0}.syllable-tiles span{background:white;border:2px solid #d3a02b;border-radius:12px;padding:10px 16px;font-size:24px;font-weight:800}.encouragement{text-align:center;color:#8d1620;font-weight:750;margin-top:16px}.audio-bar{display:flex;justify-content:flex-end;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px}.audio-bar button{font-size:14px;padding:9px 15px}.audio-bar label{display:flex;align-items:center;gap:8px}.audio-bar input{width:100px;margin:0;padding:0}.audio-note{font-size:12px;color:#715e65}.mini-art{display:block;width:100%;max-width:460px;margin:0 auto 18px;border-radius:20px}@media(max-width:650px){.hero-art{max-height:210px}.claps{font-size:18px;letter-spacing:0}.visual-path{font-size:14px}}@media print{.audio-bar,.mini-art{display:none}}

.tonic-choices{display:flex;justify-content:center;gap:14px;flex-wrap:wrap;margin:20px 0}.tonic-choices button{min-width:95px;padding:16px 24px;border:3px solid #d7bfae;border-radius:18px;box-shadow:0 5px 0 #e8dbcf}.tonic-choices button strong{font-size:30px;color:var(--ink)}.tonic-choices button.correct{border-color:#287247;box-shadow:0 5px 0 #a9d8b6}.tonic-choices button.wrong{border-color:var(--red)}.tonic-choices button span{font-size:12px;color:#715e65}mark{background:#ffe098;color:#33252b;padding:3px 7px;border-radius:6px;font-weight:850}.sample{font-size:22px;font-weight:750}.wordbox{padding:10px}.tonic-label{font-size:14px;font-weight:800;color:#205a39;margin-top:8px}.lesson-grid p{font-size:15px}.game-guide{display:flex;align-items:center;gap:16px;justify-content:center;margin:0 auto 12px;max-width:650px}.game-guide img{max-width:210px;margin:0}.game-guide p{font-weight:750;color:var(--red)}.feedback mark{display:inline-block}.result-tonic{font-weight:850;color:var(--red);text-decoration:underline}.hero-art{object-fit:contain;max-height:none;background:#fffaf3}.tonic-choices button:disabled{opacity:1}@media(max-width:650px){.tonic-choices{gap:8px}.tonic-choices button{padding:14px 16px;min-width:72px}.tonic-choices button strong{font-size:25px}.game-guide img{max-width:130px}.game-guide p{font-size:14px}}@media print{.game-guide{display:none}header img{width:50px;height:50px}tr{break-inside:avoid}}
</style></head><body>
<header><img src="data:image/png;base64," alt="Escudo del Colegio San Francisco de Asís"><div><strong>Colegio Privado Concertado San Francisco de Asís</strong><span>Actividades de clase · Lengua · 3.º de Primaria</span></div></header>
<main><div class="audio-bar"><button id="sound" class="secondary" aria-pressed="false">🔇 Activar tic-tac</button><label for="volume">Volumen<input id="volume" type="range" min="0" max="100" value="25"></label><span class="audio-note" id="audioNote">Sonido opcional · sin límite de tiempo</span></div><section id="home"><div class="eyebrow">Escucha la palabra. Mira sus sílabas. ¡Encuentra la tónica!</div><h1>El reto de la sílaba tónica<span style="color:var(--red)">.</span></h1><p>La palabra aparecerá separada en sílabas. Pronúnciala de forma natural y pulsa la sílaba que suena más fuerte. ¡Vamos a descubrirla!</p>
<img id="heroArt" class="hero-art" src="data:image/png;base64," alt="Dos niños de estilo cartoon anime practicando con palmadas, una estrella animadora y un trofeo sonriente"><div class="visual-path" aria-label="Pasos para encontrar la sílaba tónica"><span>👄 Di la palabra</span><span aria-hidden="true">→</span><span>👂 Escucha la fuerza</span><span aria-hidden="true">→</span><span>⭐ Pulsa la tónica</span></div><p class="hint">Palabras sin diptongos ni hiatos. Las sílabas están preparadas: tú descubres cuál es la tónica.</p><div class="grid lesson-grid">
<div class="concept"><div class="number">👏</div><b>Una sílaba</b><p>Es cada grupo de sonidos que decimos en un golpe de voz.</p><div class="sample">ca · mi · sa</div></div>
<div class="concept"><div class="number">⭐</div><b>La sílaba tónica</b><p>Se pronuncia con más fuerza que las demás.</p><div class="sample">ca · <mark>mi</mark> · sa</div></div>
<div class="concept"><div class="number">👂</div><b>Las sílabas átonas</b><p>Son las que pronunciamos con menos fuerza.</p><div class="sample"><u>ca</u> · mi · <u>sa</u></div></div>
<div class="concept"><div class="number">✏️</div><b>Tónica y tilde</b><p>No siempre lleva tilde. Si hay tilde, está en la sílaba tónica.</p><div class="sample"><mark>lá</mark> · piz</div></div></div><div class="panel"><h2>Prepara tu reto</h2><div class="setup"><div><label for="mode">¿Cómo jugamos?</label><select id="mode"><option value="solo">Individual</option><option value="teams">Dos equipos por turnos</option></select></div><div><label id="labelA" for="nameA">Tu nombre o apodo (opcional)</label><input id="nameA" maxlength="24" placeholder="Explorador/a"></div><div id="teamB" hidden><label for="nameB">Nombre del equipo 2</label><input id="nameB" maxlength="24" placeholder="Equipo 2"></div><button id="start">¡Comenzar el reto!</button></div><p class="hint">16 palabras · 10 puntos por acierto · Sin perder puntos por los errores. El tiempo no cambia la puntuación. En equipos, cada equipo responde 8 palabras de dificultad similar.</p></div><details><summary>Para el profesor o la profesora</summary><p>Banco de 48 palabras de 2 a 5 sílabas, sin diptongos ni hiatos, con sílaba tónica revisada. Cada partida incluye 6 bisílabas, 6 trisílabas y 4 palabras más largas. En equipos, cada uno recibe 3 bisílabas, 3 trisílabas y 2 palabras más largas. Se alternan los turnos y se permite el empate. Cada elección se comprueba una sola vez y vale 10 puntos si es correcta. La rapidez no da puntos. Puedes imprimir los resultados o practicar las palabras falladas sin cambiar la puntuación inicial. Funciona sin conexión: dibujos y sonidos están integrados en el archivo.</p></details></section>
<section id="game" hidden><div class="game-guide"><img id="gameArt" class="mini-art" alt="Niños cartoon anime escuchando y señalando sílabas"><p>👂 Escucha con atención.<br>⭐ ¡Tú puedes encontrarla!</p></div><div class="row"><div><div class="eyebrow" id="phase">Reto en marcha</div><h2 id="turn"></h2></div><span class="tag" id="count"></span></div><div class="stats" id="stats"></div><progress id="progress" max="16" value="0" aria-label="Palabras respondidas"></progress><div class="panel"><div class="wordbox"><p id="question">¿Cuál es la sílaba tónica? Pulsa la que suena más fuerte.</p><div class="word" id="word"></div><div class="choices tonic-choices" id="choices" role="group" aria-label="Elige la sílaba tónica"></div><p class="hint">También puedes usar las teclas 1, 2, 3, 4 o 5 para elegir.</p></div><div class="encouragement" id="encourage">⭐ ¡Confía en ti! Di la palabra despacio.</div><div id="feedback" class="feedback" aria-live="polite">Pronuncia la palabra de forma natural y escucha qué sílaba suena más fuerte.</div><div class="actions"><button id="next" hidden>Siguiente palabra →</button></div></div><details><summary>Recordar los conceptos</summary><p>La tónica se pronuncia con más fuerza. Las demás sílabas son átonas. En ca-mi-sa, la tónica es mi. En lá-piz, es lá. Una palabra puede tener sílaba tónica sin llevar tilde.</p></details></section>
<section id="result" hidden><img id="resultArt" class="mini-art" alt="Los niños celebran tu esfuerzo con un trofeo"><div class="eyebrow">Reto completado</div><h1 id="resultTitle">¡Buen trabajo!</h1><div class="panel"><div id="scoreboard"></div><p id="message"></p><p id="time"></p><div class="actions"><button id="retry">Practicar mis errores</button><button id="again" class="secondary">Nueva partida</button><button id="print" class="secondary">Imprimir resultado</button></div></div><div class="panel"><h2>Estas son las sílabas tónicas</h2><p class="hint">✓ Acierto · ↻ Palabra para seguir practicando</p><div class="scroll"><table><thead><tr><th>Palabra</th><th>Sílabas</th><th>Tónica</th><th>Respuesta</th></tr></thead><tbody id="review"></tbody></table></div></div></section></main><footer>Aprende · Practica · Supérate &nbsp; | &nbsp; ¡Cada intento cuenta!</footer>
<script>
'use strict';
const BANK=[
['sol'],['pan'],['mar'],['sal'],['luz'],['flor'],['tren'],['pez'],['voz'],['mes'],['dos'],['tres'],['gris'],['cruz'],['tos'],['fin'],
['ca','sa'],['me','sa'],['ga','to'],['pe','rro'],['lu','na'],['so','pa'],['li','bro'],['lá','piz'],['ár','bol'],['nu','be'],['bar','co'],['dul','ce'],['ta','za'],['cam','po'],['si','lla'],['le','che'],
['ca','mi','sa'],['pe','lo','ta'],['za','pa','to'],['to','ma','te'],['co','ne','jo'],['ca','ba','llo'],['pa','lo','ma'],['ven','ta','na'],['mo','chi','la'],['cu','cha','ra'],['plá','ta','no'],['mú','si','ca'],['es','tre','lla'],['co','ci','na'],['ca','mi','no'],['se','ma','na'],
['ma','ri','po','sa'],['ca','ra','me','lo'],['te','lé','fo','no'],['bo','lí','gra','fo'],['bi','ci','cle','ta'],['cho','co','la','te'],['co','co','dri','lo'],['e','le','fan','te'],['o','ran','gu','tán'],['or','de','na','dor'],['he','li','cóp','te','ro'],['fri','go','rí','fi','co'],['ma','te','má','ti','cas'],['hi','po','pó','ta','mo'],['ca','mi','se','ta'],['fe','li','ci','dad']
].filter(s=>s.length>1).map(s=>{const w=s.join('');let t=s.findIndex(x=>/[áéíóú]/.test(x));if(t<0)t=/[aeiouns]$/.test(w)?s.length-2:s.length-1;return {w,s,t,n:Math.min(4,s.length)}});
const $=id=>document.getElementById(id);let deck=[],index=0,players=[],scores=[],answers=[],locked=false,practice=false,initialAnswers=[],started=0,elapsed=0,ticker;
function shuffle(a){a=[...a];for(let i=a.length-1;i>0;i--){let j=Math.floor(Math.random()*(i+1));[a[i],a[j]]=[a[j],a[i]]}return a}
function show(id){['home','game','result'].forEach(x=>$(x).hidden=x!==id);window.scrollTo(0,0)}
function textEl(tag,txt){const e=document.createElement(tag);e.textContent=txt;return e}
function makeDeck(){const sizes=[6,6,4];const groups=[2,3,4].map((n,i)=>shuffle(BANK.filter(w=>w.n===n)).slice(0,sizes[i]));if(players.length===1)return shuffle(groups.flat());const a=shuffle(groups.flatMap(g=>g.slice(0,g.length/2))),b=shuffle(groups.flatMap(g=>g.slice(g.length/2)));return a.flatMap((w,i)=>[w,b[i]])}
function active(){return practice?0:index%players.length}
function timerText(){const t=practice?elapsed:Math.floor((Date.now()-started)/1000);return Math.floor(t/60)+':'+String(t%60).padStart(2,'0')}
function stats(){const box=$('stats');box.replaceChildren();players.forEach((p,i)=>box.append(textEl('span',p+': '+scores[i]+' puntos')));box.append(textEl('span','Tiempo: '+timerText()))}
function start(){clearInterval(ticker);players=$('mode').value==='teams'?[$('nameA').value.trim()||'Equipo 1',$('nameB').value.trim()||'Equipo 2']:[$('nameA').value.trim()||'Explorador/a'];scores=players.map(()=>0);answers=[];initialAnswers=[];index=0;practice=false;deck=makeDeck();started=Date.now();elapsed=0;ticker=setInterval(stats,1000);show('game');render()}
function render(){locked=false;$('encourage').textContent='⭐ ¡Confía en ti! Escucha cómo suena la palabra.';$('phase').textContent=practice?'Práctica de errores · sin puntos':'Reto en marcha';$('turn').textContent=practice?'Vamos a intentarlo otra vez':players[active()]+', ¡te toca!';$('count').textContent='Palabra '+(index+1)+' de '+deck.length;$('progress').max=deck.length;$('progress').value=index;$('word').textContent=deck[index].w;$('feedback').className='feedback';$('feedback').textContent='Pronuncia la palabra de forma natural. ¿Qué sílaba suena más fuerte?';$('next').hidden=true;$('choices').replaceChildren();deck[index].s.forEach((syl,i)=>{const b=document.createElement('button');b.dataset.t=i;b.setAttribute('aria-label','Sílaba '+(i+1)+': '+syl);b.append(textEl('strong',syl),textEl('span','Tecla '+(i+1)));b.onclick=()=>answer(i);$('choices').append(b)});stats();$('choices').firstElementChild.focus()}
function answer(t){if(locked||$('game').hidden)return;locked=true;const w=deck[index],ok=w.t===t,p=active();if(!practice){if(ok)scores[p]+=10;answers.push({w,t,ok,p})}document.querySelectorAll('[data-t]').forEach(b=>{b.disabled=true;if(+b.dataset.t===w.t){b.classList.add('correct');const label=textEl('div','⭐ Tónica');label.className='tonic-label';b.append(label)}if(!ok&&+b.dataset.t===t)b.classList.add('wrong')});$('feedback').className='feedback '+(ok?'good':'miss');$('feedback').textContent=(ok?'¡Correcto! ':'Vamos a aprenderlo: ')+ 'La sílaba tónica de «'+w.w+'» es «'+w.s[w.t]+'». Suena más fuerte que las demás. '+(ok&&!practice?'+10 puntos.':'');const tiles=textEl('div','');tiles.className='syllable-tiles';w.s.forEach((syl,i)=>{const e=textEl(i===w.t?'mark':'span',syl);tiles.append(e)});$('feedback').append(tiles);$('progress').value=index+1;$('next').hidden=false;$('next').textContent=index===deck.length-1?'Ver resultado →':'Siguiente palabra →';$('encourage').textContent=ok?'🌟 ¡Sigue así, lo estás consiguiendo!':'💪 ¡Equivocarse también ayuda a aprender!';if(ok)playSuccess();stats();$('next').focus()}
function finish(){playFinish();clearInterval(ticker);if(!practice){elapsed=Math.floor((Date.now()-started)/1000);initialAnswers=[...answers]}show('result');const a=initialAnswers,correct=a.filter(x=>x.ok).length;$('resultTitle').textContent=practice?'¡Práctica terminada!':'¡Reto completado!';$('scoreboard').replaceChildren();players.forEach((p,i)=>{const div=textEl('div','');const h=textEl('h2',p);const score=textEl('div',scores[i]+' / '+(160/players.length));score.className='score';div.append(h,score,textEl('p',a.filter(x=>x.p===i&&x.ok).length+' de '+(16/players.length)+' aciertos'));$('scoreboard').append(div)});let winner=players.length===2?(scores[0]===scores[1]?'¡Empate! Los dos equipos habéis sumado lo mismo. ':'Gana '+players[scores[0]>scores[1]?0:1]+'. '):'';$('message').textContent=winner+(correct===16?'¡Has dominado el reto de la sílaba tónica!':correct>=12?'¡Muy buen trabajo! Repasa las palabras que te han costado.':'¡Cada palabra te ayuda a aprender! Practica las que te han costado y vuelve a intentarlo.')+(practice?' La práctica no cambia la puntuación de la partida.':'');$('time').textContent='Tiempo de la partida: '+Math.floor(elapsed/60)+' min '+(elapsed%60)+' s. Sin bonificación por rapidez.';$('review').replaceChildren();a.forEach(x=>{const tr=document.createElement('tr');tr.append(textEl('td',x.w.w));const syllables=textEl('td','');x.w.s.forEach((syl,i)=>{if(i)syllables.append(document.createTextNode(' · '));const e=textEl('span',syl);if(i===x.w.t)e.className='result-tonic';syllables.append(e)});tr.append(syllables,textEl('td',x.w.s[x.w.t]),textEl('td',(x.ok?'✓ ':'↻ ')+x.w.s[x.t]+(players.length===2?' · '+players[x.p]:'')));$('review').append(tr)});$('retry').hidden=a.every(x=>x.ok);$('retry').textContent=practice?'Volver a practicar los errores':'Practicar mis errores'}
$('mode').onchange=()=>{$('teamB').hidden=$('mode').value!=='teams';$('labelA').textContent=$('mode').value==='teams'?'Nombre del equipo 1':'Tu nombre o apodo (opcional)';$('nameA').placeholder=$('mode').value==='teams'?'Equipo 1':'Explorador/a'};$('start').onclick=start;$('next').onclick=()=>{if(!locked||$('game').hidden)return;index++;if(index===deck.length)finish();else render()};$('again').onclick=()=>{show('home');$('start').focus()};$('retry').onclick=()=>{deck=shuffle(initialAnswers.filter(x=>!x.ok).map(x=>x.w));index=0;practice=true;show('game');render()};$('print').onclick=()=>window.print();document.addEventListener('keydown',e=>{if(!['INPUT','SELECT','TEXTAREA','BUTTON'].includes(e.target.tagName)&&/^[1-5]$/.test(e.key)&&!$('game').hidden){const t=+e.key-1;if(t<deck[index].s.length){e.preventDefault();answer(t)}}else if(e.target.tagName==='BUTTON'&&/^[1-5]$/.test(e.key)&&!$('game').hidden){const t=+e.key-1;if(t<deck[index].s.length){e.preventDefault();answer(t)}}});
$('gameArt').src='data:image/png;base64,';$('resultArt').src=$('heroArt').src;
let audioCtx=null,soundOn=false,tickTimer=null,tickAlternate=false;
function tone(freq,duration,delay=0,type='sine',level=.2){if(!soundOn||!audioCtx||document.hidden)return;const at=audioCtx.currentTime+delay;const osc=audioCtx.createOscillator(),gain=audioCtx.createGain();osc.type=type;osc.frequency.setValueAtTime(freq,at);const volume=Number($('volume').value)/100;gain.gain.setValueAtTime(0,at);gain.gain.linearRampToValueAtTime(volume*level,at+.005);gain.gain.exponentialRampToValueAtTime(.0001,at+duration);osc.connect(gain);gain.connect(audioCtx.destination);osc.start(at);osc.stop(at+duration+.01)}
function playSuccess(){tone(523,.13);tone(659,.18,.13)}
function playFinish(){tone(523,.16);tone(659,.16,.17);tone(784,.35,.34)}
$('sound').onclick=async()=>{if(soundOn){soundOn=false;clearInterval(tickTimer);tickTimer=null;$('sound').textContent='🔇 Activar tic-tac';$('sound').setAttribute('aria-pressed','false');if(audioCtx)await audioCtx.suspend();return}try{const AudioCtor=window.AudioContext||window.webkitAudioContext;if(!AudioCtor)throw new Error('Audio no disponible');if(!audioCtx)audioCtx=new AudioCtor();await audioCtx.resume();soundOn=true;$('sound').textContent='🔊 Silenciar tic-tac';$('sound').setAttribute('aria-pressed','true');$('audioNote').textContent='Tic-tac suave mientras piensas · sin límite de tiempo';tone(650,.07);tickTimer=setInterval(()=>{if(!$('game').hidden&&!locked&&!document.hidden){tickAlternate=!tickAlternate;tone(tickAlternate?900:680,.045,0,'sine',.13)}},700)}catch(e){soundOn=false;$('audioNote').textContent='Este navegador no permite reproducir sonido.'}};
</script></body></html>
